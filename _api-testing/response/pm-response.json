bkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; height: 100%; -moz-font-feature-settings: 'liga' on; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; width: 100%; -moz-osx-font-smoothing: grayscale;\">    <tr>      <td style=\"margin: 0; padding: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;\">        <table role=\"presentation\" align=\"center\" class=\"wrapper\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 620px; margin: auto;\">          <tr>            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; width: 10px;\"> </td>            <td style=\"margin: 0; padding: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;\">              <table role=\"presentation\" class=\"preheader\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; color: #1C252E;\">                <tr>                  <td style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px; font-size: 10px;\">                  </td>                </tr>              </table>              <table role=\"presentation\" align=\"center\" class=\"main\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; color: #1C252E; background: #fff; border-radius: 2px;\" class=\"content-bg\">                <tr>                  <td style=\"margin: 0; padding: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;\">                  <!-- Remove the text below this comment and insert header/content sections -->                  <style type=\"text/css\">                  @media (max-width: 600px) {                    /* line 9, ../../../sass/headers/responsive/img.scss */                    .header img {                      width: auto !important;                      max-width: 100%;                    }                  }                  /*# sourceMappingURL=img.css.map */                  </style>                  <table role=\"presentation\" class=\"header\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: center; background: #F1F6FB;\">                    <tbody><tr>                      <td style=\"margin: 0; padding: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;padding-bottom: 30px; padding-top: 30px;\">                        <img width=\"200\" src=\"https://www.travelguard.com/content/dam/tg-documents/travel-guard/us/en/CM_Travel_Guard_v_RGB.png\" style=\"border: 0; outline: none; display: block; margin: auto; width: 200px; max-width: 200px; border-radius: 2px 2px 0 0; background: transparent;\">                      </td>                    </tr>                  </tbody></table>                  <table role=\"presentation\" class=\"header\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: center;\">                    <tr>                      <td style=\"margin: 0; padding: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;\">                        <img width=\"235\" src=\"https://www.travelguard.com/content/dam/tg-documents/travel-guard/us/en/FulfillmentEmail_HeaderImage.jpg\" style=\"border: 0; outline: none; display: block; margin: auto; width: 235px; border-radius: 2px 2px 0 0;\">                      </td>                      <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 18px; vertical-align: middle; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; color: #fff; padding: 0 40px; font-weight: bold; background-color: #003D6E; text-align: left;\">                        Grazie per aver acquistato un piano di assicurazione viaggio Travel Guard&reg;!                      </td>                    </tr>                  </table>                  <table role=\"presentation\" class=\"columns\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif;\">                    <tr>                      <td class=\"col-1\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 40px; width: 600px;\">                        <!-- Remove the text between this comment and the comment closest to it and insert content sections -->                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              Buongiorno QAFNAMEPFFSJUZDLI1 QATESTLASTNAME,<br>                              <br>                              <b style=\"color: #001871;\">Questa polizza assicurativa offre copertura solo ai residenti in Italia.</b><br>                              <br>                              Grazie per aver scelto la polizza assicurativa Travel Guard®! <br>                              Il Suo numero di Polizza è <b>836075237.</b><br>                              <br>                              <b><a href='https://policy.uat.travelguard.com/lhgroup/it/it' target='_blank'><u>Clicca qui</u></a></b> per visualizzare e scaricare il <b style=\"color: #001871;\">Certificato di Assicurazione</b> ed il <a href='https://documents.uat.travelguard.com/dynamicdoc/cs?parser=tags&document-type=pwd&partner=lhgroup&country=it&language=it&product=ti&ISP=Zurich' target='_blank' style='color: #1352de;'><u>Set Informativo</u></a>.<br>                              Per accedere è necessario il Numero di Polizza e il Cognome.                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E; border-bottom: 1px solid #9CC7E6;\">Che cosa è assicurato?</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              Ha acquistato l’assicurazione Worldwide. L’elenco delle garanzie incluse in copertura sono indicate nel certificato di assicurazione e nelle condizioni generali di polizza. <br>                              <br>                              Questa polizza offre copertura per situazioni ed eventi specifici che possono accadere durante il viaggio. La polizza prevede delle esclusioni e/o limitazioni di cui la preghiamo di prendere visione, leggendo attentamente il Set Informativo.                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E; border-bottom: 1px solid #9CC7E6;\">Requisiti di idoneità della polizza:</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              <ul>                                <li>La polizza fornisce copertura solo a Contraenti/Assicurati residenti in ITALY.</li>                                <li>Si prega di leggere attentamente il set informativo per ogni ulteriore dettaglio.</li>                              </ul>                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E; border-bottom: 1px solid #9CC7E6;\">Informazioni importanti</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E;\">Chi devo contattare se ho una domanda sulla mia polizza?</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              In caso di domande e /o informazioni sulla sua polizza, la preghiamo di contattare il numero +39 02 369 06 99, 09:00 - 17:00 Lunedì - Venerdì o di inviare una e-mail al seguente indirizzo <a href='mailto:airlines@cs.covermoreeurope.com'>airlines@cs.covermoreeurope.com</a> <br><a href='https://covermore-europe-airlines.zendesk.com/hc/' target='_blank'> https://covermore-europe-airlines.zendesk.com/hc/</a> indicando il numero di polizza 836075237. <br>                              <br>                              Ha il diritto di ricevere copia in formato cartaceo della documentazione di polizza a mezzo posta, senza costi aggiuntivi, chiamando il numero di cui sopra o inoltrando una e-mail all’indirizzo sopra citato.                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E;\">Chi devo contattare in caso di emergenza medica?</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              In caso di emergenza medica può chiamare Travel Guard in qualsiasi momento al numero +39 02 369 06 98 o inviare una e-mail a IT.Assistance@travelguard.com <br>                              I nostri centri di assistenza sono operativi 24/24 H e 7 giorni su 7.                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"head\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; text-align: left; margin-bottom: 16px;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; font-size: 18px; font-weight: bold; padding-top: 16px; color: #003D6E;\">Come denunciare un sinistro?</td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-bottom: 25px;\">                              Può contattare il nostro ufficio sinistri telefonicamente al numero +39 02 369 06 99, 09:00 - 17:00 Lunedì - Venerdì o inviare una e-mail a IT.Claims@travelguard.com<br>                              <br>                              Fare <a href='https://policy.uat.travelguard.com/lhgroup/it/en' target='_blank'><u>clic qui</u></a> per visualizzare i dettagli della polizza in inglese.                            </td>                          </tr>                        </table>                        <table role=\"presentation\" class=\"text\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; margin: 0 auto; line-height: 1.5;\">                          <tr>                            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding-top: 25px; padding-bottom: 0;\">                              Viaggi sicuro!<br>                              <b style=\"color: #003D6E;\">Travel Guard</b>                            </td>                          </tr>                        </table>                        <!-- Remove the text between this comment and the comment closest to it and insert content sections -->                      </td>                    </tr>                  </table>                  <!-- Remove the text above this comment and insert header/content sections -->                  </td>                </tr>              </table>              <table role=\"presentation\" class=\"footer\" style=\"border-collapse: collapse; border-spacing: 0; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; width: 100%; color: #343741;\">                <tr>                  <td style=\"margin: 0; border: 0; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px; font-size: 10px;\">                  </td>                </tr>              </table>            </td>            <td class=\"spacer\" style=\"margin: 0; border: 0; font-size: 16px; vertical-align: baseline; font-family: 'Noto Sans', 'Source Sans Pro', Arial, sans-serif; padding: 16px 0; width: 10px;\"></td>          </tr>        </table>      </td>    </tr>  </table></body></html><div class=\"clear\"></div></div>    </div>    </div>            </div>                    <script src=\"https://documents.uat.travelguard.com/etc.clientlibs/core/wcm/components/commons/site/clientlibs/container.min.js\"></script><script src=\"https://documents.uat.travelguard.com/etc.clientlibs/core/wcm/components/accordion/v1/accordion/clientlibs/site.min.js\"></script>            <script src=\"https://documents.uat.travelguard.com/etc.clientlibs/tgfoundation/cli