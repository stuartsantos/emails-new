{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/mcp-preflight.sh",
            "timeout": 15,
            "statusMessage": "Running MCP pre-flight check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/validate-email-html.sh",
            "timeout": 30,
            "statusMessage": "Validating email template..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__chrome-devtools__take_screenshot",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_page"
    ]
  }
}
